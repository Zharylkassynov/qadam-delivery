# Local development only. Replace the placeholder with a generated password.
# Keep POSTGRES_PASSWORD and the password in DATABASE_URL identical.
POSTGRES_DB=qadam_delivery
POSTGRES_USER=qadam
POSTGRES_PASSWORD=replace_with_a_random_password
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql://qadam:replace_with_a_random_password@127.0.0.1:55432/qadam_delivery

# Local academic demo only. Disable demo auth on deployments not meant for the demo.
DEMO_AUTH_ENABLED=true
DEMO_PASSWORD=QadamDemo-2026!
APP_ORIGIN=http://127.0.0.1:3000

# Separate database used only by automated tests.
TEST_DATABASE_URL=postgresql://qadam:replace_with_a_random_password@127.0.0.1:55432/qadam_delivery_test
