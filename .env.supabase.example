# Copy to .env.supabase. The local .env and Docker configuration remain separate.
# Use the Session pooler hostname copied from Connect -> Direct -> Session pooler.
SUPABASE_PROJECT_REF=your_project_ref
DATABASE_URL=postgresql://qadam_app.your_project_ref:replace_with_app_password@your_pooler_host:5432/postgres
DATABASE_POOL_MAX=3
QADAM_NEXT_DIST_DIR=.next-cloud
# Public root CA downloaded from Database -> Settings -> Download certificate.
DATABASE_SSL_CA_FILE=config/certs/supabase-root.crt
DEMO_AUTH_ENABLED=true
DEMO_PASSWORD=QadamDemo-2026!
APP_ORIGIN=http://127.0.0.1:3001
