# Reference only. Enter values in Vercel Settings -> Environment Variables.
# Scope these values to Production; do not upload this file or .env.supabase.
APP_ORIGIN=https://your-project.vercel.app
SUPABASE_PROJECT_REF=your_project_ref
DATABASE_URL=postgresql://qadam_app.your_project_ref:replace_with_app_password@your_pooler_host:6543/postgres
DATABASE_SSL_CA_FILE=config/certs/supabase-root.crt
DATABASE_POOL_MAX=3
# true only for the controlled academic demo; this is the only implemented login.
DEMO_AUTH_ENABLED=true

# Preview: no DATABASE_URL; DEMO_AUTH_ENABLED=false (or unset).
# Preview APP_ORIGIN defaults to the exact VERCEL_URL supplied by the platform.
# Do not set DEMO_PASSWORD, TEST_DATABASE_URL or QADAM_NEXT_DIST_DIR on Vercel.
